#!/bin/bash

# If you come from bash you might have to change your $PATH.
# export PATH=$HOME/bin:/usr/local/bin:$PATH

# Path to your oh-my-zsh installation.
export ZSH="$HOME/.oh-my-zsh"

# Set name of the theme to load --- if set to "random", it will
# load a random theme each time oh-my-zsh is loaded, in which case,
# to know which specific one was loaded, run: echo $RANDOM_THEME
# See https://github.com/ohmyzsh/ohmyzsh/wiki/Themes
ZSH_THEME="steeef"

# Which plugins would you like to load?
# Standard plugins can be found in $ZSH/plugins/
# Custom plugins may be added to $ZSH_CUSTOM/plugins/
# Example format: plugins=(rails git textmate ruby lighthouse)
# Add wisely, as too many plugins slow down shell startup.
plugins=(
    git                         # https://github.com/ohmyzsh/ohmyzsh/tree/master/plugins/git#functions
    history-substring-search
    zsh-autosuggestions 
    zsh-syntax-highlighting
)

# load Oh my Zsh
source $ZSH/oh-my-zsh.sh

# Use this to expand alias commands using TAB
zstyle ':completion:*' completer _expand_alias _complete _ignored

## Load my standard profile
## Needs to be symlinked `ln -s ~/dotfiles/sh/profile ~/.profile`
source $HOME/.profile

# This setting makes OTHER_WRITABLE directories bold (1) and red (31)
# This is to override the default horrible colours
# Mostly to make working with Windows directories via WSL shells nicer
LS_COLORS=$LS_COLORS':ow=1;31:'

export EDITOR=vim
export GIT_EDITOR=vim
# make grep results RED
export GREP_OPTIONS='--color=auto' GREP_COLOR='mt=1;32'

# start Starship
eval "$(starship init zsh)"
# current Startship prompt is: https://starship.rs/presets/gruvbox-rainbow