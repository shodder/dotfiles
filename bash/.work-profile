
# load git aliases and commands
if [ -f "$HOME/dotfiles/git/git-commands" ] ; then
    source "$HOME/dotfiles/git/git-commands"
fi

# load git aliases and commands
if [ -f "$HOME/dotfiles/git/git-releases" ] ; then
    source "$HOME/dotfiles/git/git-releases"
fi

# kube
export KUBECONFIG_DEV_BLUE="$HOME/.kubecfg/kubernetes-kubeconfig-dev-blue"
export KUBECONFIG_DEV_GREEN="$HOME/.kubecfg/kubernetes-kubeconfig-dev-green"
export KUBECONFIG_PROD_BLUE="$HOME/.kubecfg/kubernetes-kubeconfig-prod-blue"
export KUBECONFIG_PROD_GREEN="$HOME/.kubecfg/kubernetes-kubeconfig-prod-green"

# DEFAULT - CONNECT TO DEV
export KUBECONFIG=$KUBECONFIG_DEV_BLUE

# Just checking
echo "Loaded shodders work profile"
echo 'Using kubeconf:' $KUBECONFIG'\n\n'

